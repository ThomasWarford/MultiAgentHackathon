# Required for Stages 1-6 (local refinement backend uses this too)
OPENAI_API_KEY=

# Required only when config.refinement_backend = "denario"
DENARIO_BASE_URL=
DENARIO_API_KEY=

# Optional — overrides config.py defaults
MATCHMAKER_COST_CEILING_USD=5.0
MATCHMAKER_MAX_ITERATIONS=3
MATCHMAKER_REFINEMENT_BACKEND=local
MATCHMAKER_ON_PROTOCOL_ERROR=fallback_to_local
MATCHMAKER_LOG_LEVEL=INFO
